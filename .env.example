# Copy this file to `.env` (gitignored) to supply the sample app's client
# token. Expo inlines `EXPO_PUBLIC_*` variables into the JS bundle at build
# time — a development convenience only; never commit a real token, and never
# ship one in a production app this way.
#
# After editing .env, restart the dev server with `npx expo start --clear`.

EXPO_PUBLIC_DVM_CLIENT_TOKEN=
